# DOWN KILOS – ENVIRONMENT CONFIGURATION
# Kopiere diese Datei zu .env und passe bei Bedarf Werte an.
# Sensible Zugangsdaten niemals in Git committen!

# Anwendungs-Umgebung
NODE_ENV=development

# App Base URL
APP_URL=http://localhost:4200

# Standard-Discounter (V1: Netto Marken-Discount)
DEFAULT_RETAILER_ID=netto
NETTO_ONLINE_URL=https://www.netto-online.de/
OPEN_FOOD_FACTS_API=https://world.openfoodfacts.org/api/v2
OPEN_PRICES_API=https://prices.openfoodfacts.org/api/v1
